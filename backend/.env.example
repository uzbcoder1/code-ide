# ==============================================
# CodeStudio IDE — Environment Variables
# ==============================================
# Bu fayl namuna sifatida. Haqiqiy qiymatlarni 
# hosting dashboard'da environment variables ga qo'shing.
# ==============================================

# JWT Secret Key — 32+ belgili random kalit bo'lishi kerak
# Generatsiya: python -c "import secrets; print(secrets.token_hex(32))"
CODE_STUDIO_SECRET_KEY=your-secret-key-here

# Admin login ma'lumotlari
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password-here
ADMIN_EMAIL=admin@yourdomain.com

# Database URL
DATABASE_URL=postgresql://user:password@host:5432/code_studio

# Frontend URL (CORS uchun) — vergul bilan ajratilgan
FRONTEND_URL=https://your-frontend-domain.com

